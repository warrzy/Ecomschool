# ECOM-SCHOOL — ordonnanceur des traitements applicatifs (/api/cron).
# Fichier : /etc/cron.d/ecomschool-preprod
#
# Le CRON_SECRET est lu depuis shared/.env à l'exécution — jamais injecté ici.
# flock -n évite les exécutions concurrentes ; le traitement est idempotent.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

*/10 * * * * deploy flock -n /tmp/ecomschool-cron.lock sh -c 'curl -fsS -o /dev/null -m 300 -H "Authorization: Bearer $(sed -n "s/^CRON_SECRET=//p" /var/www/ecomschool-preprod/shared/.env | tr -d "\"")" http://127.0.0.1:3001/api/cron' || echo "$(date -Is) ecomschool cron failed" >> /var/log/ecomschool/cron-errors.log

# Sauvegarde quotidienne à 02:30 (rotation 14 jours + copie distante si configurée).
30 2 * * * deploy bash /var/www/ecomschool-preprod/current/deploy/scripts/backup.sh >> /var/log/ecomschool/backup.log 2>&1

# Supervision toutes les 15 min : sauvegardes, cron, jobs DEAD, dispo, disque.
# Alertes dédupliquées vers ALERT_WEBHOOK_URL (ou e-mail provider).
*/15 * * * * deploy bash /var/www/ecomschool-preprod/current/deploy/scripts/monitor.sh >> /var/log/ecomschool/monitor.log 2>&1

# Vérification de restauration hebdomadaire (dimanche 04:10) sur base témoin
# isolée — jamais la base applicative. Verrou + timeout + rapport + alerte.
10 4 * * 0 deploy bash /var/www/ecomschool-preprod/current/deploy/scripts/restore-verify-run.sh >> /var/log/ecomschool/restore-verify.log 2>&1
