  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  coefficient Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
  @@index([teacherId])
