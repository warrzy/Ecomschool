  status            ResultStatus @default(DRAFT)

  headTeacherNote     String?
  generalAppreciation String?
  councilDecision     String?
  directionNote       String?
  directionSignedById String?
  directionSignedAt   DateTime?

  computedAt   DateTime?
  computedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicPeriodId, studentId])
  @@index([schoolId])
  @@index([classroomId])
}

model StudentAnnualResult {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  annualAverage Float?
  rank          Int?
  mention       String?
  decision      String?
  status        ResultStatus @default(DRAFT)

  computedAt   DateTime?
  computedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, studentId])
  @@index([schoolId])
}

model ResultValidation {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  status ResultStatus @default(DRAFT)
  note   String?

  computedById   String?
  computedAt     DateTime?
  validatedById  String?
  validatedBy    User?     @relation("ResultValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt    DateTime?
  publishedById  String?
  publishedBy    User?     @relation("ResultPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, academicPeriodId])
  @@index([schoolId])
}

model ReportCard {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  identifier String

  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  status         ResultStatus @default(DRAFT)
  currentVersion Int          @default(0)
  templateKey    String       @default("standard")

  generatedById String?
  publishedAt   DateTime?
  publishedById String?

  versions ReportCardVersion[]

  createdAt DateTime @default(now())
