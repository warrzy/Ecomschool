  reenrollmentRequestsSource ReenrollmentRequest[] @relation("ReenrollSource")
  reenrollmentRequestsNew    ReenrollmentRequest[] @relation("ReenrollNew")

  @@index([schoolId])
  @@index([studentId])
  @@index([classroomId])
  @@index([academicYearId])
  @@index([schoolId, status])
}

model LevelSubject {
