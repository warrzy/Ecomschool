generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AcademicPeriodType {
  TRIMESTER
  SEMESTER
  OTHER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleScope {
  PLATFORM
  SCHOOL
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum SchoolType {
  PRIMARY
  MIDDLE
  HIGH
  MIXED
  OTHER
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  FINANCIAL
  EMERGENCY
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

enum RoomType {
  CLASSROOM
  LAB
  SCIENCE
  SPORT
  ADMIN
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionStatus {
  PLANNED
  DONE
  CANCELLED
  POSTPONED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  UNMARKED
}

enum AssessmentStatus {
  DRAFT
  OPEN
  SUBMITTED
  VALIDATED
  PUBLISHED
  CANCELLED
}

enum GradeStatus {
  ENTERED
  MISSING
  ABSENT
  EXEMPT
  CANCELLED
}

enum ResultStatus {
  DRAFT
  CALCULATED
  PENDING_VALIDATION
  VALIDATED
  PUBLISHED
  RECTIFIED
}

enum RoundingMode {
  HALF_UP
  FLOOR
  CEIL
}

enum TieRule {
  SHARED_RANK
  DENSE_RANK
}

enum MissingGradePolicy {
  EXCLUDE
  ZERO
}

model School {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  slug      String       @unique
  address   String?
  city      String?
  country   String       @default("BF")
  phone     String?
  email     String?
  website   String?
  currency  String       @default("XOF")
  timezone  String       @default("Africa/Ouagadougou")
  locale    String       @default("fr")
  status    SchoolStatus @default(ACTIVE)

  type         SchoolType?
  schoolSystem AcademicPeriodType?
  logoUrl      String?
  settings     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  roles           Role[]
  memberships     SchoolMembership[]
  academicPeriods AcademicPeriod[]
  academicYears   AcademicYear[]
  auditLogs       AuditLog[]
  levels          Level[]
  classrooms      Classroom[]
  teachers        Teacher[]
  subjects        Subject[]
  teachingAssignments TeachingAssignment[]
  students        Student[]
  guardians       Guardian[]
  studentGuardians StudentGuardian[]
  enrollments     Enrollment[]
  levelSubjects   LevelSubject[]
  classroomSubjects ClassroomSubject[]
  rooms           Room[]
  courseSchedules CourseSchedule[]
  courseSessions  CourseSession[]
  attendanceRecords AttendanceRecord[]
  gradingPolicies     GradingPolicy[]
  assessmentTypes     AssessmentType[]
  assessments         Assessment[]
  grades              Grade[]
  subjectResults      SubjectPeriodResult[]
  studentPeriodResults StudentPeriodResult[]
  studentAnnualResults StudentAnnualResult[]
  resultValidations   ResultValidation[]
  reportCards         ReportCard[]
  reportCardTemplates ReportCardTemplate[]
  announcements       Announcement[]
  notifications       Notification[]
  accountInvites      AccountInvite[]

  @@index([status])
}

model User {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  email        String     @unique
  passwordHash String
  firstName    String?
  lastName     String?
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles   UserRole[]
  memberships SchoolMembership[]
  auditLogs   AuditLog[]
  teachers    Teacher[]
  recordedAttendance AttendanceRecord[] @relation("AttendanceRecorder")
  justifiedAttendance AttendanceRecord[] @relation("AttendanceJustifier")
  recordedGrades      Grade[]              @relation("GradeRecorder")
  gradeRevisions      GradeRevision[]     @relation("GradeReviser")
  validatedResults    ResultValidation[]  @relation("ResultValidator")
  publishedResults    ResultValidation[]  @relation("ResultPublisher")
  reportCardVersions  ReportCardVersion[] @relation("ReportCardVersionCreator")
  studentAccounts   Student[]  @relation("StudentAccount")
  guardianAccounts  Guardian[] @relation("GuardianAccount")
  notifications     Notification[]
  accountInvites    AccountInvite[]

  @@index([schoolId])
  @@index([email])
}

model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  userId    String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([roleId])
}

// Unicité assurée par indexes uniques partiels SQL (ajoutés manuellement dans la migration M2):
// - (scope, name) unique quand schoolId IS NULL
// - (scope, schoolId, name) unique quand schoolId IS NOT NULL
model Role {
  id          String  @id @default(cuid())
  name        String
  description String?

  scope    RoleScope @default(SCHOOL)
  schoolId String?
  school   School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  memberships     SchoolMembership[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model AcademicYear {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods             AcademicPeriod[]
  classrooms          Classroom[]
  teachingAssignments TeachingAssignment[]
  enrollments         Enrollment[]
  courseSchedules     CourseSchedule[]
  courseSessions      CourseSession[]
  gradingPolicies     GradingPolicy[]
  assessments         Assessment[]
  studentAnnualResults StudentAnnualResult[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
}

model AcademicPeriod {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  name      String
  number    Int
  startDate DateTime
  endDate   DateTime
  type      AcademicPeriodType
  isLocked  Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments         Assessment[]
  subjectResults      SubjectPeriodResult[]
  studentResults      StudentPeriodResult[]
  resultValidations   ResultValidation[]
  reportCards         ReportCard[]

  @@unique([academicYearId, number])
  @@index([academicYearId])
  @@index([academicYearId, isLocked])
  @@index([schoolId])
}

model Level {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  name   String
  order  Int          @default(0)
  status RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classrooms Classroom[]
  subjects   LevelSubject[]
  gradingPolicies     GradingPolicy[]
  reportCardTemplates ReportCardTemplate[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
}

model Teacher {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  email     String?
  phone     String?
  status    RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  headOfClassrooms Classroom[]
  assignments      TeachingAssignment[]
  classroomSubjects ClassroomSubject[]
  courseSchedules   CourseSchedule[]
  courseSessions    CourseSession[]
  assessments       Assessment[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([userId])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  name         String
  code         String?
  subjectGroup String?
  status       RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments       TeachingAssignment[]
  levelAssignments  LevelSubject[]
  classAssignments  ClassroomSubject[]
  courseSchedules   CourseSchedule[]
  courseSessions    CourseSession[]
  assessments       Assessment[]
  subjectResults    SubjectPeriodResult[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
}

model TeachingAssignment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classroomId, subjectId, academicYearId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classroomId])
  @@index([subjectId])
  @@index([academicYearId])
}

model Classroom {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  headTeacherId String?
  headTeacher   Teacher? @relation(fields: [headTeacherId], references: [id], onDelete: SetNull)

  name     String
  section  String?
  capacity Int?
  room     String?
  status   RecordStatus @default(ACTIVE)

  assignments TeachingAssignment[]
  enrollments Enrollment[]
  subjects    ClassroomSubject[]
  courseSchedules CourseSchedule[]
  courseSessions  CourseSession[]
  assessments       Assessment[]
  subjectResults    SubjectPeriodResult[]
  studentResults    StudentPeriodResult[]
  resultValidations ResultValidation[]
  reportCards       ReportCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([levelId])
  @@index([schoolId, status])
}

model Student {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  matricule  String
  firstName  String
  lastName   String
  sex        Gender?
  birthDate  DateTime?
  birthPlace String?
  photoUrl   String?
  address    String?
  phone      String?
  email      String?
  status     RecordStatus @default(ACTIVE)

  userId String?
  user   User?   @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians   StudentGuardian[]
  enrollments Enrollment[]
  attendanceRecords AttendanceRecord[]
  grades            Grade[]
  subjectResults    SubjectPeriodResult[]
  periodResults     StudentPeriodResult[]
  annualResults     StudentAnnualResult[]
  reportCards       ReportCard[]

  @@unique([schoolId, matricule])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
  @@index([userId])
}

model Guardian {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  firstName String
  lastName  String
  phone     String?
  email     String?
  address   String?
  status    RecordStatus @default(ACTIVE)

  userId String?
  user   User?   @relation("GuardianAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentGuardian[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, lastName])
  @@index([userId])
}

model StudentGuardian {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  relation GuardianRelation

  createdAt DateTime @default(now())

  @@unique([studentId, guardianId, relation])
  @@index([schoolId])
  @@index([studentId])
  @@index([guardianId])
}

model Enrollment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  enrolledAt DateTime         @default(now())
  leftAt     DateTime?
  status     EnrollmentStatus @default(ENROLLED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unicité partielle ajoutée manuellement dans la migration :
  // un seul ENROLLED par (studentId, academicYearId).

  @@index([schoolId])
  @@index([studentId])
  @@index([classroomId])
  @@index([academicYearId])
  @@index([schoolId, status])
}

model LevelSubject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  levelId   String
  level     Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  coefficient Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([levelId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
}

model ClassroomSubject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  coefficient Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, subjectId])
  @@index([schoolId])
  @@index([subjectId])
  @@index([teacherId])
}

model Room {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  code     String
  name     String
  capacity Int?
  building String?
  floor    String?
  type     RoomType     @default(CLASSROOM)
  status   RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules CourseSchedule[]
  sessions  CourseSession[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([schoolId, status])
}

model CourseSchedule {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  weekday Weekday
  startMin Int // minutes depuis minuit
  endMin   Int

  validFrom  DateTime
  validUntil DateTime?

  status RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions CourseSession[]

  @@index([schoolId])
  @@index([classroomId])
  @@index([teacherId])
  @@index([roomId])
  @@index([academicYearId, weekday])
}

model CourseSession {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  scheduleId String?
  schedule   CourseSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  date     DateTime // jour (00:00)
  startMin Int
  endMin   Int

  status             SessionStatus @default(PLANNED)
  movedToDate        DateTime?
  movedToStartMin    Int?
  movedToEndMin      Int?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content    CourseContent?
  attendance AttendanceRecord[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([classroomId, date])
  @@index([teacherId, date])
  @@index([roomId, date])
  @@index([scheduleId])
}

model CourseContent {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   CourseSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  theme     String?
  chapter   String?
  objective String?
  content   String?
  homework  String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendanceRecord {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  sessionId String?
  session   CourseSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  date   DateTime
  status AttendanceStatus @default(UNMARKED)

  durationMin Int? // retard : minutes ; absence : durée
  expectedMin Int? // heure prévue (retard)
  arrivalMin  Int? // heure d'arrivée (retard)

  reason        String?
  justification String?
  justifiedAt   DateTime?
  justifiedById String?
  justifiedBy   User?    @relation("AttendanceJustifier", fields: [justifiedById], references: [id], onDelete: SetNull)

  recordedById String?
  recordedBy   User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unicités partielles ajoutées manuellement dans la migration :
  // - (sessionId, studentId) quand sessionId IS NOT NULL
  // - (studentId, date) quand sessionId IS NULL (appel journalier)

  @@index([schoolId])
  @@index([studentId])
  @@index([sessionId])
  @@index([schoolId, date])
  @@index([schoolId, status])
}

model AuditLog {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  actorId String?
  actor   User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

model GradingPolicy {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  levelId String?
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  maxScore  Float @default(20)
  minScore  Float @default(0)
  precision Int   @default(2)
  rounding  RoundingMode @default(HALF_UP)
  passMark  Float @default(10)

  missingGradePolicy MissingGradePolicy @default(EXCLUDE)
  absentPolicy       MissingGradePolicy @default(EXCLUDE)
  exemptPolicy       MissingGradePolicy @default(EXCLUDE)

  tieRule        TieRule @default(SHARED_RANK)
  perSubjectRank Boolean @default(true)

  mentions      Json? // [{ label, min }]
  annualWeights Json? // { periodId: coefficient }

  version Int          @default(1)
  status  RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, levelId])
  @@index([schoolId])
  // Index partiel manuel : une seule politique par défaut par année (levelId IS NULL)
}

model AssessmentType {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  code         String
  name         String
  defaultCoefficient Float @default(1)
  order        Int          @default(0)
  status       RecordStatus @default(ACTIVE)

  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Assessment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  academicPeriodId String?
  academicPeriod   AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  typeId String
  type   AssessmentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  title       String
  date        DateTime
  maxScore    Float   @default(20)
  coefficient Float   @default(1)
  description String?
  status      AssessmentStatus @default(DRAFT)

  grades Grade[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([classroomId])
  @@index([academicPeriodId])
  @@index([teacherId])
  @@index([schoolId, status])
}

model Grade {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  value       Float?
  status      GradeStatus @default(MISSING)
  observation String?

  recordedById String?
  recordedBy   User?    @relation("GradeRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  revisions GradeRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model GradeRevision {
  id      String @id @default(cuid())
  gradeId String
  grade   Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  oldValue  Float?
  newValue  Float?
  oldStatus GradeStatus
  newStatus GradeStatus
  reason    String?

  changedById String?
  changedBy   User?   @relation("GradeReviser", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([gradeId])
}

model SubjectPeriodResult {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  average        Float?
  coefficient    Float?
  weightedPoints Float?
  rank           Int?
  appreciation   String?
  isComplete     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicPeriodId, studentId, subjectId])
  @@index([schoolId])
  @@index([classroomId])
}

model StudentPeriodResult {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  generalAverage    Float?
  totalCoefficients Float   @default(0)
  subjectsCount     Int     @default(0)
  rank              Int?
  mention           String?
  isComplete        Boolean @default(true)
  status            ResultStatus @default(DRAFT)

  headTeacherNote     String?
  generalAppreciation String?
  councilDecision     String?
  directionNote       String?
  directionSignedById String?
  directionSignedAt   DateTime?

  computedAt   DateTime?
  computedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicPeriodId, studentId])
  @@index([schoolId])
  @@index([classroomId])
}

model StudentAnnualResult {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  annualAverage Float?
  rank          Int?
  mention       String?
  decision      String?
  status        ResultStatus @default(DRAFT)

  computedAt   DateTime?
  computedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, studentId])
  @@index([schoolId])
}

model ResultValidation {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  status ResultStatus @default(DRAFT)
  note   String?

  computedById   String?
  computedAt     DateTime?
  validatedById  String?
  validatedBy    User?     @relation("ResultValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt    DateTime?
  publishedById  String?
  publishedBy    User?     @relation("ResultPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classroomId, academicPeriodId])
  @@index([schoolId])
}

model ReportCard {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  identifier String

  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  status         ResultStatus @default(DRAFT)
  currentVersion Int          @default(0)
  templateKey    String       @default("standard")

  generatedById String?
  publishedAt   DateTime?
  publishedById String?

  versions ReportCardVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, identifier])
  @@unique([academicPeriodId, studentId])
  @@index([schoolId])
  @@index([classroomId])
}

model ReportCardVersion {
  id          String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  version Int
  payload Json
  reason  String?

  createdById String?
  createdBy   User?    @relation("ReportCardVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([reportCardId, version])
}

model ReportCardTemplate {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  key     String
  name    String
  levelId String?
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: SetNull)

  layout    Json?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
}

enum AnnouncementAudience {
  ALL
  PARENTS
  STUDENTS
  TEACHERS
}

enum NotificationType {
  REPORT_CARD_PUBLISHED
  ANNOUNCEMENT
  ABSENCE_UNJUSTIFIED
  LATENESS
  ADMIN_MESSAGE
}

model Announcement {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  title    String
  body     String
  audience AnnouncementAudience @default(ALL)

  publishedAt DateTime?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, publishedAt])
}

model Notification {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  link  String?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([schoolId])
}

model AccountInvite {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}
