generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AcademicPeriodType {
  TRIMESTER
  SEMESTER
  OTHER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RoleScope {
  PLATFORM
  SCHOOL
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum SchoolType {
  PRIMARY
  MIDDLE
  HIGH
  MIXED
  OTHER
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum GradingPolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  FINANCIAL
  EMERGENCY
}

enum EnrollmentStatus {
  ENROLLED
  TRANSFERRED
  WITHDRAWN
  COMPLETED
}

enum RoomType {
  CLASSROOM
  LAB
  SCIENCE
  SPORT
  ADMIN
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionStatus {
  PLANNED
  DONE
  CANCELLED
  POSTPONED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  UNMARKED
}

enum AssessmentStatus {
  DRAFT
  OPEN
  SUBMITTED
  VALIDATED
  PUBLISHED
  CANCELLED
}

enum GradeStatus {
  ENTERED
  MISSING
  ABSENT
  EXEMPT
  CANCELLED
}

enum ResultStatus {
  DRAFT
  CALCULATED
  PENDING_VALIDATION
  VALIDATED
  PUBLISHED
  RECTIFIED
}

enum RoundingMode {
  HALF_UP
  FLOOR
  CEIL
}

enum TieRule {
  SHARED_RANK
  DENSE_RANK
}

enum MissingGradePolicy {
  EXCLUDE
  ZERO
}

model School {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  slug      String       @unique
  address   String?
  city      String?
  country   String       @default("BF")
  phone     String?
  email     String?
  website   String?
  currency  String       @default("XOF")
  timezone  String       @default("Africa/Ouagadougou")
  locale    String       @default("fr")
  status    SchoolStatus @default(ACTIVE)

  type         SchoolType?
  schoolSystem AcademicPeriodType?
  logoUrl      String?
  settings     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  roles           Role[]
  memberships     SchoolMembership[]
  academicPeriods AcademicPeriod[]
  academicYears   AcademicYear[]
  auditLogs       AuditLog[]
  levels          Level[]
  classrooms      Classroom[]
  teachers        Teacher[]
  subjects        Subject[]
  teachingAssignments TeachingAssignment[]
  students        Student[]
  guardians       Guardian[]
  studentGuardians StudentGuardian[]
  enrollments     Enrollment[]
  levelSubjects   LevelSubject[]
  classroomSubjects ClassroomSubject[]
  rooms           Room[]
  courseSchedules CourseSchedule[]
  courseSessions  CourseSession[]
  attendanceRecords AttendanceRecord[]
  gradingPolicies     GradingPolicy[]
  assessmentTypes     AssessmentType[]
  assessments         Assessment[]
  grades              Grade[]
  subjectResults      SubjectPeriodResult[]
  studentPeriodResults StudentPeriodResult[]
  studentAnnualResults StudentAnnualResult[]
  resultValidations   ResultValidation[]
  reportCards         ReportCard[]
  reportCardTemplates ReportCardTemplate[]
  announcements       Announcement[]
  notifications       Notification[]
  accountInvites      AccountInvite[]
  feeCategories       FeeCategory[]
  feeTariffs          FeeTariff[]
  feeCharges          StudentFeeCharge[]
  feeInstallments     FeeInstallment[]
  feeDiscounts        FeeDiscount[]
  payments            Payment[]
  cashClosures        CashClosure[]
  feeReminders        FeeReminder[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  documents           Document[]
  admissionCampaigns  AdmissionCampaign[]
  admissionApplications AdmissionApplication[]
  admissionEvents     AdmissionEvent[]
  admissionMessages   AdmissionMessage[]
  admissionInterviews AdmissionInterview[]
  reenrollmentCampaigns ReenrollmentCampaign[]
  reenrollmentRequests  ReenrollmentRequest[]
  reenrollmentMessages  ReenrollmentMessage[]
  paymentProviders    PaymentProvider[]
  paymentIntents      PaymentIntent[]
  paymentTransactions PaymentTransaction[]

  subscriptions            SchoolSubscription[]
  moduleOverrides          SchoolModuleOverride[]
  platformInvoices         PlatformInvoice[]
  platformPayments         PlatformPayment[]
  platformCreditNotes      PlatformCreditNote[]
  supportSessions          SupportSession[]
  subscriptionChangeRequests SubscriptionChangeRequest[]
  signupRequests             SchoolSignupRequest[]

  schoolMessages    SchoolMessage[]

  @@index([status])
}

model User {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  email        String     @unique
  passwordHash String
  firstName    String?
  lastName     String?
  status       UserStatus @default(ACTIVE)

  // Anti force-brute : compteur persistant + verrouillage temporaire.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Alertes commerciales WhatsApp (utilisateurs plateforme uniquement) :
  // numéro E.164 auto-déclaré + consentement explicite, désactivé par défaut.
  whatsappNumber String?
  whatsappOptIn  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles   UserRole[]
  memberships SchoolMembership[]
  auditLogs   AuditLog[]
  teachers    Teacher[]
  recordedAttendance AttendanceRecord[] @relation("AttendanceRecorder")
  justifiedAttendance AttendanceRecord[] @relation("AttendanceJustifier")
  recordedGrades      Grade[]              @relation("GradeRecorder")
  gradeRevisions      GradeRevision[]     @relation("GradeReviser")
  validatedResults    ResultValidation[]  @relation("ResultValidator")
  publishedResults    ResultValidation[]  @relation("ResultPublisher")
  reportCardVersions  ReportCardVersion[] @relation("ReportCardVersionCreator")
  studentAccounts   Student[]  @relation("StudentAccount")
  guardianAccounts  Guardian[] @relation("GuardianAccount")
  notifications     Notification[]
  accountInvites    AccountInvite[]
  supportAgentSessions     SupportSession[]
  supportAuthorizedSessions SupportSession[] @relation("SupportAuthorizedBy")
  assignedAdmissions AdmissionApplication[] @relation("AdmissionAssignedTo")
  decidedAdmissions  AdmissionApplication[] @relation("AdmissionDecider")
  admissionConditionsLifts AdmissionApplication[] @relation("AdmissionConditionsLifter")
  admissionConversions     AdmissionApplication[] @relation("AdmissionConverter")
  reenrollmentCampaigns    ReenrollmentCampaign[]  @relation("ReenrollCampaignCreator")
  reenrollmentSubmissions  ReenrollmentRequest[]   @relation("ReenrollSubmitter")
  reenrollmentDecisions    ReenrollmentRequest[]   @relation("ReenrollDecider")
  reenrollmentCompletions  ReenrollmentRequest[]   @relation("ReenrollCompleter")
  reenrollmentMessages     ReenrollmentMessage[]   @relation("ReenrollMsgAuthor")
  paymentIntents           PaymentIntent[]         @relation("PaymentIntentInitiator")

  @@index([schoolId])
  @@index([email])
}

model SchoolMembership {
  id        String           @id @default(cuid())
  schoolId  String
  userId    String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@index([roleId])
}

// Unicité assurée par indexes uniques partiels SQL (ajoutés manuellement dans la migration M2):
// - (scope, name) unique quand schoolId IS NULL
// - (scope, schoolId, name) unique quand schoolId IS NOT NULL
model Role {
  id          String  @id @default(cuid())
  name        String
  description String?

  scope    RoleScope @default(SCHOOL)
  schoolId String?
  school   School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  memberships     SchoolMembership[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model FeeCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  code        String
  label       String
  description String?
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tariffs FeeTariff[]
  charges StudentFeeCharge[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model FeeTariff {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  categoryId String
  category   FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  levelId     String?
  level       Level?     @relation(fields: [levelId], references: [id], onDelete: Restrict)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  amount           Int // XOF, entier — jamais de flottant
  currency         String @default("XOF")
  mandatory        Boolean @default(true)
  paymentPlan      FeePaymentPlan @default(SINGLE)
  installmentCount Int @default(1)
  effectiveFrom    DateTime @default(now())
  conditions       String?
  status           RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges StudentFeeCharge[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([levelId])
  @@index([classroomId])
  @@index([categoryId])
}

/** Créance : frais appliqué à un élève pour une année (figé à la génération). */
model StudentFeeCharge {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  categoryId String
  category   FeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tariffId String?
  tariff   FeeTariff? @relation(fields: [tariffId], references: [id], onDelete: SetNull)

  amount   Int // montant figé à l'établissement de la créance
  currency String @default("XOF")
  status   RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments FeeInstallment[]

  @@unique([studentId, academicYearId, categoryId])
  @@index([schoolId])
  @@index([academicYearId])
}

/** Échéance de paiement rattachée à une créance. */
model FeeInstallment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  chargeId String
  charge   StudentFeeCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  label    String?
  dueDate  DateTime
  amount   Int
  currency String @default("XOF")
  status   RecordStatus @default(ACTIVE) // ACTIVE ou ARCHIVED — le statut métier est calculé

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]
  paymentIntents PaymentIntent[]

  @@index([schoolId])
  @@index([studentId])
  @@index([dueDate])
  @@index([academicYearId])
}

/** Réduction/bourse/exonération — historisée, jamais supprimée physiquement. */
model FeeDiscount {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  type  DiscountType
  value Int // FIXED_* : montant XOF ; PERCENT : pourcentage (0-100)
  reason String
  status RecordStatus @default(ACTIVE) // ARCHIVED = réduction annulée (historique conservé)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
}

model Payment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  amount      Int
  currency    String @default("XOF")
  paidAt      DateTime @default(now())
  method      PaymentMethod
  reference   String?
  observation String?

  receivedById String?
  status       PaymentStatus @default(VALIDATED)
  cancelledAt  DateTime?
  cancelledById String?
  cancelReason  String?

  receiptNumber   String?
  receiptSnapshot Json?

  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]
  intent      PaymentIntent?

  @@unique([schoolId, receiptNumber])
  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([paidAt])
  @@index([status])
}

/** Répartition d'un paiement sur les échéances. */
model PaymentAllocation {
  id         String @id @default(cuid())
  paymentId  String
  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  installmentId String
  installment   FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  amount Int

  createdAt DateTime @default(now())

  @@unique([paymentId, installmentId])
  @@index([installmentId])
}

/** Clôture de caisse journalière. */
model CashClosure {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  date        DateTime
  totalAmount Int
  paymentsCount Int
  closedById  String?
  closedAt    DateTime @default(now())

  @@unique([schoolId, date])
  @@index([schoolId])
}

/** Relance d'impayé (historique interne). */
model FeeReminder {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  installmentId String?
  note          String
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
}

/** Catégorie de dépense (fonctionnement, salaires, fournitures…). */
model ExpenseCategory {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  code        String
  label       String
  description String?
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

/**
 * Dépense / décaissement d'un établissement.
 * Cycle : DRAFT → PAID, DRAFT|PAID → CANCELLED (motif obligatoire).
 * Jamais de suppression physique — la trace du décaissement est conservée.
 * `method`/`paidAt` sont facultatifs tant que la dépense est DRAFT ;
 * ils deviennent obligatoires au passage PAID.
 */
model Expense {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  label       String
  amount      Int // XOF, entier — jamais de flottant
  currency    String @default("XOF")
  beneficiary String
  expenseAt   DateTime @default(now())
  paidAt      DateTime?
  method      PaymentMethod?
  paymentReference  String?
  attachmentRef     String?

  status        ExpenseStatus @default(DRAFT)
  recordedById  String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, idempotencyKey])
  @@index([schoolId])
  @@index([categoryId])
  @@index([academicYearId])
  @@index([expenseAt])
  @@index([paidAt])
  @@index([status])
}

model AcademicYear {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periods             AcademicPeriod[]
  classrooms          Classroom[]
  teachingAssignments TeachingAssignment[]
  enrollments         Enrollment[]
  courseSchedules     CourseSchedule[]
  courseSessions      CourseSession[]
  gradingPolicies     GradingPolicy[]
  assessments         Assessment[]
  studentAnnualResults StudentAnnualResult[]
  feeTariffs          FeeTariff[]
  feeCharges          StudentFeeCharge[]
  feeInstallments     FeeInstallment[]
  feeDiscounts        FeeDiscount[]
  payments            Payment[]
  expenses            Expense[]
  admissionCampaigns  AdmissionCampaign[]
  reenrollmentCampaignsSource ReenrollmentCampaign[] @relation("ReenrollSourceYear")
  reenrollmentCampaignsTarget ReenrollmentCampaign[] @relation("ReenrollTargetYear")
  reenrollmentRequestsTarget  ReenrollmentRequest[]  @relation("ReenrollReqTargetYear")
  paymentIntents            PaymentIntent[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
}

model AcademicPeriod {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  name      String
  number    Int
  startDate DateTime
  endDate   DateTime
  type      AcademicPeriodType
  isLocked  Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments         Assessment[]
  subjectResults      SubjectPeriodResult[]
  studentResults      StudentPeriodResult[]
  resultValidations   ResultValidation[]
  reportCards         ReportCard[]

  @@unique([academicYearId, number])
  @@index([academicYearId])
  @@index([academicYearId, isLocked])
  @@index([schoolId])
}

model Level {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  name   String
  order  Int          @default(0)
  status RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classrooms Classroom[]
  subjects   LevelSubject[]
  gradingPolicies     GradingPolicy[]
  reportCardTemplates ReportCardTemplate[]
  feeTariffs          FeeTariff[]
  admissionApplications AdmissionApplication[]
  reenrollmentRequestsDesired ReenrollmentRequest[] @relation("ReenrollDesiredLevel")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
}

model Teacher {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  email     String?
  phone     String?
  status    RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  headOfClassrooms Classroom[]
  assignments      TeachingAssignment[]
  classroomSubjects ClassroomSubject[]
  courseSchedules   CourseSchedule[]
  courseSessions    CourseSession[]
  assessments       Assessment[]

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([userId])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  name         String
  code         String?
  subjectGroup String?
  status       RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments       TeachingAssignment[]
  levelAssignments  LevelSubject[]
  classAssignments  ClassroomSubject[]
  courseSchedules   CourseSchedule[]
  courseSessions    CourseSession[]
  assessments       Assessment[]
  subjectResults    SubjectPeriodResult[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
}

model TeachingAssignment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  teacherId  String
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classroomId, subjectId, academicYearId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classroomId])
  @@index([subjectId])
  @@index([academicYearId])
}

model Classroom {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  headTeacherId String?
  headTeacher   Teacher? @relation(fields: [headTeacherId], references: [id], onDelete: SetNull)

  name     String
  section  String?
  capacity Int?
  room     String?
  status   RecordStatus @default(ACTIVE)

  assignments TeachingAssignment[]
  enrollments Enrollment[]
  subjects    ClassroomSubject[]
  courseSchedules CourseSchedule[]
  courseSessions  CourseSession[]
  assessments       Assessment[]
  subjectResults    SubjectPeriodResult[]
  studentResults    StudentPeriodResult[]
  resultValidations ResultValidation[]
  reportCards       ReportCard[]
  feeTariffs        FeeTariff[]
  admissionApplications AdmissionApplication[]
  reenrollmentRequestsDesired ReenrollmentRequest[] @relation("ReenrollDesiredClassroom")
  reenrollmentRequestsTarget  ReenrollmentRequest[] @relation("ReenrollTargetClassroom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([levelId])
  @@index([schoolId, status])
}

model Student {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  matricule  String
  firstName  String
  lastName   String
  sex        Gender?
  birthDate  DateTime?
  birthPlace String?
  photoUrl   String?
  address    String?
  phone      String?
  email      String?
  status     RecordStatus @default(ACTIVE)

  userId String?
  user   User?   @relation("StudentAccount", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guardians   StudentGuardian[]
  enrollments Enrollment[]
  attendanceRecords AttendanceRecord[]
  grades            Grade[]
  subjectResults    SubjectPeriodResult[]
  periodResults     StudentPeriodResult[]
  annualResults     StudentAnnualResult[]
