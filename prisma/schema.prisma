  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
}

enum AnnouncementAudience {
  ALL
  PARENTS
  STUDENTS
  TEACHERS
}

enum NotificationType {
  REPORT_CARD_PUBLISHED
  ANNOUNCEMENT
  ABSENCE_UNJUSTIFIED
  LATENESS
  ADMIN_MESSAGE
  FINANCE_REMINDER
}

enum FeePaymentPlan {
  SINGLE
  INSTALLMENTS
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  VALIDATED
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENT
  SCHOLARSHIP
  EXEMPTION
  FAMILY
  EXCEPTIONAL
}

model Announcement {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  title    String
  body     String
  audience AnnouncementAudience @default(ALL)

  publishedAt DateTime?
  scheduledAt DateTime?
  archivedAt DateTime? // conservation : archivée ≠ supprimée
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, publishedAt])
}

model Notification {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  link  String?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([schoolId])
}

model AccountInvite {
  id       String @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}

// ===================== PHASE 8 — SaaS commercial ECOM-TOUCH =====================

/** Catalogue des fonctionnalités commercialisables. */
model PlatformModule {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String?
  dependsOn   String[] @default([])
  commercial  Boolean @default(true)
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planModules PlanModule[]
  overrides   SchoolModuleOverride[]
}

/** Formule commerciale (prix en entiers XOF). */
model SubscriptionPlan {
  id   String @id @default(cuid())
  code String @unique

  name        String
  description String?

  monthlyPrice Int    @default(0)
  yearlyPrice  Int    @default(0)
  currency     String @default("XOF")

  maxStudents Int?
  maxUsers    Int?

  trialDays Int          @default(0)
  graceDays Int          @default(7)
  status    RecordStatus @default(ACTIVE)

  // true = offre commercialisable affichée sur les pages publiques ;
  // false = plan technique ou de test, réservé à l'administration.
  commercial Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules       PlanModule[]
  subscriptions SchoolSubscription[]
  changeRequests SubscriptionChangeRequest[]
  signupRequests SchoolSignupRequest[]
}

model PlanModule {
  id       String @id @default(cuid())
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  moduleId String
  module   PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([planId, moduleId])
}

/** Abonnement d'un établissement (historique conservé). */
model SchoolSubscription {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status             SubscriptionStatus @default(TRIALING)
  cycle              BillingCycle       @default(MONTHLY)
  startedAt          DateTime           @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?

  suspendedAt DateTime?
  cancelledAt DateTime?
  endedAt     DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events   SubscriptionEvent[]
  invoices PlatformInvoice[]

  @@index([schoolId, status])
  @@index([status, currentPeriodEnd])
}

model SubscriptionEvent {
  id             String @id @default(cuid())
  subscriptionId String
  subscription   SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type       SubscriptionEventType
  fromPlanId String?
  toPlanId   String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([subscriptionId, createdAt])
}

/** Activation/désactivation forcée d'un module pour une école (hors plan). */
model SchoolModuleOverride {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  moduleId String
  module   PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  enabled     Boolean
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([schoolId, moduleId])
}

/** Demande de changement d'offre émise par l'établissement (validation plateforme). */
model SubscriptionChangeRequest {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  subscriptionId  String?
  requestedPlanId String
  requestedPlan   SubscriptionPlan @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)

  note         String?
  status       ChangeRequestStatus @default(PENDING)
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([schoolId, status])
}

/**
 * Demande d'inscription publique d'un établissement (site vitrine).
 * Cycle : PENDING → CONTACTED → APPROVED → CONVERTED (ou REJECTED).
 * Aucun User/School n'est créé à la soumission — la conversion passe par
 * l'onboarding plateforme, qui rattache convertedSchoolId.
 */
model SchoolSignupRequest {
  id String @id @default(cuid())

  schoolName   String
  city         String?
  country      String?
  phone        String?
  email        String?
  website      String?

  contactName  String
  contactEmail String
  contactPhone String?

  note String?

  requestedPlanId String?
  requestedPlan   SubscriptionPlan? @relation(fields: [requestedPlanId], references: [id], onDelete: SetNull)

  status       SignupRequestStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  convertedSchoolId String?  @unique
  convertedSchool   School?  @relation(fields: [convertedSchoolId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contactEmail])
}

// ---------- Facturation SaaS (indépendante des finances scolaires) ----------

/** Configuration facturation ECOM-TOUCH (singleton id="platform"). */
model PlatformConfig {
  id          String  @id @default("platform")
  legalName   String?
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String?
  taxId       String?
  invoiceFooter String?
  defaultGraceDays Int @default(7)
  updatedAt   DateTime @updatedAt
}

model PlatformInvoice {
  id             String @id @default(cuid())
  invoiceNumber  String @unique
  schoolId       String
  school         School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  subscriptionId String?
  subscription   SchoolSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  status  PlatformInvoiceStatus @default(ISSUED)
  cycle   BillingCycle          @default(MONTHLY)
  issueDate DateTime            @default(now())
  dueDate   DateTime
  periodStart DateTime?
  periodEnd   DateTime?

  total    Int
  currency String @default("XOF")
  snapshot Json? // émetteur, client, lignes, montants — immuable

  cancelledAt  DateTime?
  cancelReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines       PlatformInvoiceLine[]
  payments    PlatformPayment[]
  creditNotes PlatformCreditNote[]

  @@index([schoolId, status])
  @@index([status, dueDate])
}

model PlatformInvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  invoice   PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  label     String
  quantity  Int @default(1)
  unitPrice Int
  amount    Int
}

model PlatformPayment {
  id        String @id @default(cuid())
  invoiceId String
  invoice   PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  reference String?
  observation String?
  receivedById String?

  status       PaymentStatus @default(VALIDATED)
  cancelledAt  DateTime?
  cancelledById String?
  cancelReason  String?

  idempotencyKey String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@index([schoolId])
}

/** Avoir (note de crédit) — réduit le solde dû de la facture. */
model PlatformCreditNote {
  id              String @id @default(cuid())
  creditNoteNumber String @unique
  invoiceId       String
  invoice         PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  amount      Int
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([schoolId])
}

/** Session d'assistance ECOM-TOUCH auprès d'un établissement (autorisée, limitée, journalisée). */
model SupportSession {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Restrict)

  reason         String
  authorizedById String?
  authorizedBy   User?   @relation("SupportAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)

  status    SupportSessionStatus @default(ACTIVE)
  startedAt DateTime             @default(now())
  expiresAt DateTime
  endedAt   DateTime?
  createdAt DateTime             @default(now())

  @@index([schoolId, status])
  @@index([agentId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SubscriptionEventType {
  CREATED
  TRIAL_STARTED
  TRIAL_EXTENDED
  ACTIVATED
  PLAN_CHANGED
  RENEWED
  PAST_DUE
  GRACE_STARTED
  SUSPENDED
  REACTIVATED
  CANCELLED
  EXPIRED
  CHANGE_REQUESTED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SignupRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  CONVERTED
  REJECTED
}

enum PlatformInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SupportSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

// ===================== PHASE 9 — Communication multicanale =====================

enum MessageChannel {
  INTERNAL
  EMAIL
  SMS
  WHATSAPP
}

/** TRANSACTIONAL : communications nécessaires (non désinscriptibles). */
enum CommTopic {
  TRANSACTIONAL
  ACADEMIC
  FINANCE
  ANNOUNCEMENT
  OPTIONAL
}

enum MessageAudience {
  ALL_PARENTS
  CLASS_PARENTS
  GUARDIAN
  STUDENTS
  TEACHERS
  STAFF
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENT
  PARTIAL
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
  BLOCKED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  DEAD
}

enum PrefAction {
  OPT_IN
  OPT_OUT
}

/** Message émis par un établissement vers ses utilisateurs. */
model SchoolMessage {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  subject String
  body    String

  audience    MessageAudience
  classroomId String?
  guardianId  String?

  channels    MessageChannel[] @default([INTERNAL])
  topic       CommTopic        @default(OPTIONAL)
  status      MessageStatus    @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries MessageDelivery[]

  @@index([schoolId, status])
  @@index([schoolId, scheduledAt])
}

/** Une tentative d'envoi par destinataire et par canal. */
model MessageDelivery {
  id        String          @id @default(cuid())
  /** Nullable : les envois plateforme (reset, alertes SaaS) n'ont pas d'école. */
  schoolId  String?
  messageId String?
  message   SchoolMessage?  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId     String?
  guardianId String?
  channel    MessageChannel
  address    String?

  status      DeliveryStatus @default(QUEUED)
  attempts    Int            @default(0)
  lastError   String?
  providerRef String?
  costUnits   Int            @default(0)
  sentAt      DateTime?

  /** Déduplication : type métier + cible + période. */
  dedupKey String? @unique

  createdAt DateTime @default(now())

  @@index([schoolId, status])
  @@index([messageId])
  @@index([userId])
}

/** Préférence d'un utilisateur par canal et par sujet (OPTIONAL/ACADEMIC/etc.). */
model UserCommPreference {
  id      String         @id @default(cuid())
  userId  String
  channel MessageChannel
  topic   CommTopic
  enabled Boolean        @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, channel, topic])
  @@index([userId])
}

/** Historique des consentements (opt-in / opt-out). */
model CommConsentEvent {
  id     String         @id @default(cuid())
  userId String?
  channel MessageChannel
  topic   CommTopic
  action  PrefAction
  actorId String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Consentement des tuteurs sans compte (SMS/WhatsApp vers le téléphone). */
model GuardianCommConsent {
  id         String         @id @default(cuid())
  schoolId   String
  guardianId String         @unique
  smsOptIn   Boolean        @default(false)
  whatsappOptIn Boolean     @default(false)
  optOutAll  Boolean        @default(false)
  updatedAt  DateTime       @updatedAt
  createdAt  DateTime       @default(now())

  @@index([schoolId])
}

/** Templates de messages transactionnels, configurables par la plateforme. */
model MessageTemplate {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  channel  MessageChannel
  subject  String?
  body     String
  status   RecordStatus @default(ACTIVE)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/** File d'attente persistante : retries progressifs, déduplication, reprise. */
model Job {
  id      String @id @default(cuid())
  type    String
  payload Json
  schoolId String?

  runAt       DateTime @default(now())
  status      JobStatus @default(PENDING)
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  lastError   String?
  dedupKey    String?  @unique

  createdAt  DateTime @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, runAt])
  @@index([schoolId])
}

/** Historique d'exécution des tâches planifiées (automatisations). */
model TaskRun {
  id        String   @id @default(cuid())
  task      String
  scopeId   String?
  status    String
  detail    Json?
  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@index([task, startedAt])
}

enum DocumentStatus {
  ACTIVE
  REPLACED
  DELETED
  PURGED
}

enum AdmissionCampaignStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum AdmissionApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  WAITLISTED
  ACCEPTED
  CONDITIONALLY_ACCEPTED
  REJECTED
  CONVERTED
  WITHDRAWN
}

/**
 * Brique documentaire transversale (G2-A) : fichier privé associé à un
 * objet métier générique. `ownerType`/`ownerId` restent des chaînes sans
 * clé étrangère — la cible varie (candidature, élève, dépense…) et la
 * liste des types est validée côté service.
 *
 * Cycle : ACTIVE → REPLACED (nouvelle version créée) → DELETED (logique,
 * motif) → PURGED (fichier physiquement purgé, métadonnées conservées).
 * Jamais de suppression de ligne.
 */
model Document {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  ownerType String  @default("STANDALONE")
  ownerId   String?

  category    String
  label       String?
  description String?

  fileName     String
  originalName String
  extension    String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storagePath  String

  status       DocumentStatus @default(ACTIVE)
  version      Int            @default(1)
  replacedById String?
  replacedAt   DateTime?
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  purgedAt     DateTime?

  uploadedById String?
  uploadedByIp String?
  /** Jeton public opaque — futur accès limité (suivi candidature G2-B). */
  accessToken  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, fileName])
  @@index([schoolId, status])
  @@index([schoolId, ownerType, ownerId])
  @@index([sha256])
}

/**
 * G2-B — Campagne d'admission d'un établissement.
 * Une campagne publiée (OPEN) et dans sa fenêtre [opensAt, closesAt]
 * accepte les candidatures publiques sans compte.
 */
model AdmissionCampaign {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  name         String
  description  String?
  instructions String?

  opensAt DateTime
  closesAt DateTime
  status  AdmissionCampaignStatus @default(DRAFT)

  /** Level.id ciblés (Json string[]) — null/vide = tous les niveaux actifs. */
  targetLevelIds Json?
  /** Libellés de formations/filières libres (instituts, université). */
  trainingOptions Json?
  /** Pièces exigées : [{ key, label, category, required? }] — clés stables. */
  requiredDocs Json @default("[]")

  /** Capacité indicative (affichage back-office, pas de blocage). */
  capacity       Int?
  /**
   * Capacité contraignante : si true, ACCEPTED/CONDITIONALLY_ACCEPTED sont
   * refusés au-delà de `capacity`. false = avertissement sans blocage.
   * Ne concerne que l'admission — la capacité réelle des classes est
   * arbitrée à la conversion (G2-D).
   */
  capacityEnforced Boolean @default(false)
  /** Frais de candidature indicatifs en FCFA — réglés au guichet (pas de paiement en ligne à ce stade). */
  applicationFee Int?

  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications AdmissionApplication[]

  @@index([schoolId, status])
  @@index([academicYearId])
}

/**
 * Dossier de candidature déposé sur le portail public.
 * `trackingHash` = SHA-256 du code de suivi remis au déposant — le code
 * en clair n'est jamais stocké ni journalisé.
 * `submissionGroupId` regroupe les dossiers déposés dans la même
 * soumission (multi-enfants) : un seul code de suivi pour la fratrie.
 * Les liens studentId/guardianId/enrollmentId sont remplis à la
 * conversion (G2-D) — jamais avant.
 */
model AdmissionApplication {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  campaignId String
  campaign   AdmissionCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  fileNumber        String @unique
  trackingHash      String
  submissionGroupId String
  /** Empreinte normalisée anti double-soumission (même contenu = idempotent). */
  fingerprint       String?
  /** Dossier probablement en double — signalé à l'instruction, non bloquant. */
  duplicateOfId     String?

  status AdmissionApplicationStatus @default(SUBMITTED)

  candidateFirstName String
  candidateLastName  String
  birthDate          DateTime?
  birthPlace         String?
  sex                Gender?
  previousSchool     String?
  /** Candidat majeur déposant pour lui-même — les champs responsable restent facultatifs. */
  selfApplicant      Boolean @default(false)

  targetLevelId      String?
  targetLevel        Level?      @relation(fields: [targetLevelId], references: [id], onDelete: SetNull)
  targetClassroomId  String?
  targetClassroom    Classroom?  @relation(fields: [targetClassroomId], references: [id], onDelete: SetNull)
  targetTraining     String?
  /** Réponses aux champs complémentaires configurés (libre, validé JSON). */
  extraInfo          Json?

  guardianFirstName String?
  guardianLastName  String?
  guardianRelation  String?
  guardianPhone     String
  guardianEmail     String?
  guardianAddress   String?
  secondaryContact  String?

  submittedAt DateTime @default(now())
  submittedIp String?

  /** Complément demandé — visible sur la page de suivi (G2-C complet). */
  infoRequestNote String?
  decisionReason  String?
  /** Conditions de l'admission conditionnelle — visibles par le candidat. */
  decisionConditions String?
  /** Rang en liste d'attente (facultatif). */
  waitlistRank    Int?
  decidedById     String?
  decidedBy       User?    @relation("AdmissionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  /** Agent instructeur affecté au dossier (membre de l'établissement). */
  assignedToId    String?
  assignedTo      User?    @relation("AdmissionAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  /** Conditions d'une admission conditionnelle formellement levées (G2-D). */
  conditionsLiftedAt   DateTime?
  conditionsLiftedById String?
  conditionsLiftedBy   User?     @relation("AdmissionConditionsLifter", fields: [conditionsLiftedById], references: [id], onDelete: SetNull)

  /** Conversion en inscription définitive (G2-D) — irréversible. */
  convertedAt   DateTime?
  convertedById String?
  convertedBy   User?     @relation("AdmissionConverter", fields: [convertedById], references: [id], onDelete: SetNull)

  studentId    String?
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  guardianId   String?
  guardian     Guardian?   @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  events     AdmissionEvent[]
  messages   AdmissionMessage[]
  interviews AdmissionInterview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, campaignId, status])
  @@index([schoolId, status])
  @@index([submissionGroupId])
  @@index([trackingHash])
}

/** Journal des transitions d'un dossier — traçabilité publique + back-office. */
model AdmissionEvent {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fromStatus AdmissionApplicationStatus?
  toStatus   AdmissionApplicationStatus
  actorId    String?
  /** "portail" pour les actions du déposant, sinon nom de l'agent. */
  actorLabel String
  note       String?

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([schoolId])
}

enum AdmissionInterviewType {
  INTERVIEW
  WRITTEN_TEST
  EVALUATION
  OTHER
}

enum AdmissionInterviewStatus {
  PLANNED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/**
 * G2-C — Test ou entretien d'admission (facultatif, avant décision).
 * `instructions` est visible par le candidat dans son suivi ;
 * `result` et `internalNote` sont strictement internes.
 * `previousScheduledAt` trace la date d'origine après reprogrammation.
 */
model AdmissionInterview {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type        AdmissionInterviewType
  scheduledAt DateTime
  /** Lieu physique ou modalité (salle, visio…) — visible candidat. */
  location      String?
  /** Évaluateur / responsable — nom affiché en interne. */
  evaluatorId   String?
  evaluatorName String?
  /** Consignes destinées au candidat (visibles dans le suivi). */
  instructions  String?
  /** Résultat / note d'évaluation — interne uniquement. */
  result        String?
  /** Appréciation interne de l'évaluateur — jamais publique. */
  internalNote  String?

  status AdmissionInterviewStatus @default(PLANNED)
  /** Date d'origine conservée après reprogrammation (traçabilité). */
  previousScheduledAt DateTime?

  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@index([schoolId, status, scheduledAt])
}

/** Message lié à un dossier (demande de complément, note interne). */
model AdmissionMessage {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  kind              String  @default("INFO_REQUEST")
  body              String
  createdById       String?
  visibleToApplicant Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([schoolId])
}

// ---------- G2-E : réinscriptions annuelles ----------

enum ReenrollmentCampaignStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

/**
 * NOT_STARTED n'est pas persisté : il désigne un élève éligible sans
 * demande (état calculé du tableau de bord).
 */
enum ReenrollmentRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ReenrollmentKind {
  REENROLL
  DEPARTURE
}

/** Nature de la progression décidée pour l'année cible. */
enum ReenrollmentProgression {
  PROMOTION
  REPETITION
  SAME_LEVEL
  CLASS_CHANGE
  CYCLE_CHANGE
  RETURN
}

/**
 * Campagne de réinscription d'une année source vers une année cible.
 * Isolée par établissement ; une seule campagne non archivée par année
 * cible est garantie côté service.
 */
model ReenrollmentCampaign {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  sourceYearId String
  sourceYear   AcademicYear @relation("ReenrollSourceYear", fields: [sourceYearId], references: [id], onDelete: Restrict)
  targetYearId String
  targetYear   AcademicYear @relation("ReenrollTargetYear", fields: [targetYearId], references: [id], onDelete: Restrict)

  name         String
  description  String?
  instructions String?
  familyMessage String?

  opensAt DateTime
  closesAt DateTime
  status  ReenrollmentCampaignStatus @default(DRAFT)

  /** Level.id source concernés (Json string[]) — vide = tous. */
  targetLevelIds Json?
  /** Surcharges de progression {sourceLevelId: targetLevelId}. */
  progressionOverrides Json?
  /** Pièces exigées : [{ key, label, category, required? }]. */
  requiredDocs Json @default("[]")
  /**
   * Règle configurable : si true, un élève avec un solde impayé sur
   * l'année source ne peut pas être finalisé (blocage métier affiché).
   */
  blockOnUnpaid Boolean @default(false)

  createdById String?
  createdBy   User?   @relation("ReenrollCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests ReenrollmentRequest[]

  @@index([schoolId, status])
  @@index([schoolId, targetYearId])
}

/**
 * Demande de réinscription d'un élève existant pour l'année cible.
 * L'unicité (studentId, targetYearId) interdit toute seconde demande
 * pour la même année — y compris entre campagnes.
 */
model ReenrollmentRequest {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  campaignId String
  campaign   ReenrollmentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /** Dénormalisé depuis la campagne — sert à l'unicité par année cible. */
  targetYearId String
  targetYear   AcademicYear @relation("ReenrollReqTargetYear", fields: [targetYearId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /** Inscription de l'année source (nulle pour un retour après interruption). */
  sourceEnrollmentId String?
  sourceEnrollment   Enrollment? @relation("ReenrollSource", fields: [sourceEnrollmentId], references: [id], onDelete: SetNull)

  /** Responsable déposant (nul si dépôt administratif). */
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  submittedById String?
  submittedBy   User?   @relation("ReenrollSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  kind   ReenrollmentKind           @default(REENROLL)
  status ReenrollmentRequestStatus  @default(SUBMITTED)

  /** Souhait exprimé par la famille (changement de niveau/classe). */
  desiredLevelId     String?
  desiredLevel       Level?     @relation("ReenrollDesiredLevel", fields: [desiredLevelId], references: [id], onDelete: SetNull)
  desiredClassroomId String?
  desiredClassroom   Classroom? @relation("ReenrollDesiredClassroom", fields: [desiredClassroomId], references: [id], onDelete: SetNull)

  /** Progression et classe cible décidées par l'administration. */
  progression       ReenrollmentProgression?
  targetClassroomId String?
  targetClassroom   Classroom? @relation("ReenrollTargetClassroom", fields: [targetClassroomId], references: [id], onDelete: SetNull)

  /** Coordonnées actualisées par la famille — appliquées à la finalisation. */
  contactUpdate Json?
  parentNote    String?
  adminNote     String?

  decisionReason String?
  decidedById    String?
  decidedBy      User?     @relation("ReenrollDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?

  newEnrollmentId String?
  newEnrollment   Enrollment? @relation("ReenrollNew", fields: [newEnrollmentId], references: [id], onDelete: SetNull)
  completedById   String?
  completedBy     User?       @relation("ReenrollCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ReenrollmentMessage[]

  @@unique([studentId, targetYearId])
  @@index([schoolId, status])
  @@index([schoolId, campaignId])
  @@index([campaignId, status])
}

/** Fil de discussion d'une demande (compléments, notes internes, décisions). */
model ReenrollmentMessage {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  requestId String
  request   ReenrollmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  kind             String  @default("INFO_REQUEST")
  body             String
  createdById      String?
  createdBy        User?   @relation("ReenrollMsgAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  visibleToParent  Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([schoolId])
}

// ---------- G3-A : intentions de paiement Mobile Money ----------

enum PaymentIntentStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
  CONFIRMED_PENDING_POSTING
}

enum PaymentIntentChannel {
  PARENT_PORTAL
  CASHIER_DESK
  ADMIN_TEST
}

enum PaymentProviderMode {
  SANDBOX
  LIVE
}

enum PaymentTxKind {
  INITIATE
  STATUS_CHECK
  CONFIRM
  FAIL
  EXPIRE
  CANCEL
  POSTING
  WEBHOOK
  REFUND
}

/** Configuration d'un canal de paiement par établissement. Secrets par référence d'env, jamais en clair. */
model PaymentProvider {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  code   String // ORANGE_MONEY | MOOV_MONEY | AGGREGATOR | SANDBOX
  label  String
  mode   PaymentProviderMode @default(SANDBOX)
  status RecordStatus @default(ACTIVE)

  minAmount Int  @default(100)
  maxAmount Int? // null = pas de plafond

  credentialsRef   String? // nom de la variable d'env contenant les identifiants
  webhookSecretRef String? // nom de la variable d'env du secret webhook
  merchantRef      String? // code marchand / msisdn de référence

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intents PaymentIntent[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

/**
 * Intention de paiement Mobile Money. Une intention n'est JAMAIS un
 * encaissement : `paymentId` n'est renseigné qu'après confirmation
 * fiable du prestataire et passage par `recordPayment`.
 * Montant/devise figés à la création, jamais modifiables ensuite.
 */
model PaymentIntent {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  providerId String
  provider   PaymentProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  feeInstallmentId String?
  feeInstallment   FeeInstallment? @relation(fields: [feeInstallmentId], references: [id], onDelete: SetNull)

  amount   Int
  currency String @default("XOF")
  payerPhone String?

  status  PaymentIntentStatus @default(CREATED)
  channel PaymentIntentChannel

  idempotencyKey String
  providerRef    String? // référence de session côté prestataire
  providerTxId   String? // identifiant de transaction prestataire (preuve)
  paymentId      String? @unique
  payment        Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  allocations Json?   // [{installmentId, amount}] — imputation explicite optionnelle
  sandboxScript Json? // scénario du simulateur (mode SANDBOX uniquement)
  failureReason String?

  initiatedById String?
  initiatedBy   User? @relation("PaymentIntentInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  expiresAt   DateTime
  confirmedAt DateTime?
  failedAt    DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PaymentTransaction[]

  @@unique([schoolId, idempotencyKey])
  @@unique([schoolId, providerId, providerRef])
  @@index([schoolId, status])
  @@index([studentId])
  @@index([academicYearId])
}

/** Trace d'un échange avec le prestataire (payloads sanitisés, sans secrets). */
model PaymentTransaction {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  intentId String
  intent   PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  kind         PaymentTxKind
  providerTxId String?
  rawStatus    String?
  payload      Json?

  createdAt DateTime @default(now())

  @@index([intentId])
  @@index([schoolId])
}
