model ReportCardVersion {
  id          String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  version Int
  payload Json
  reason  String?

  createdById String?
  createdBy   User?    @relation("ReportCardVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([reportCardId, version])
}

model ReportCardTemplate {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  key     String
  name    String
  levelId String?
  level   Level?  @relation(fields: [levelId], references: [id], onDelete: SetNull)

  layout    Json?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId])
}

enum AnnouncementAudience {
  ALL
  PARENTS
  STUDENTS
  TEACHERS
}

enum NotificationType {
  REPORT_CARD_PUBLISHED
  ANNOUNCEMENT
  ABSENCE_UNJUSTIFIED
  LATENESS
  ADMIN_MESSAGE
  FINANCE_REMINDER
}

enum FeePaymentPlan {
  SINGLE
  INSTALLMENTS
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  VALIDATED
  CANCELLED
}

enum DiscountType {
  FIXED_AMOUNT
  PERCENT
  SCHOLARSHIP
  EXEMPTION
  FAMILY
  EXCEPTIONAL
}

model Announcement {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  title    String
  body     String
  audience AnnouncementAudience @default(ALL)

  publishedAt DateTime?
  scheduledAt DateTime?
  archivedAt DateTime? // conservation : archivée ≠ supprimée
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, publishedAt])
}

model Notification {
  id       String  @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  link  String?

  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([schoolId])
}

model AccountInvite {
  id       String @id @default(cuid())
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([userId])
}

// ===================== PHASE 8 — SaaS commercial ECOM-TOUCH =====================

/** Catalogue des fonctionnalités commercialisables. */
model PlatformModule {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String?
  dependsOn   String[] @default([])
  commercial  Boolean @default(true)
  status      RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planModules PlanModule[]
  overrides   SchoolModuleOverride[]
}

/** Formule commerciale (prix en entiers XOF). */
model SubscriptionPlan {
  id   String @id @default(cuid())
  code String @unique

  name        String
  description String?

  monthlyPrice Int    @default(0)
  yearlyPrice  Int    @default(0)
  currency     String @default("XOF")

  maxStudents Int?
  maxUsers    Int?

  trialDays Int          @default(0)
  graceDays Int          @default(7)
  status    RecordStatus @default(ACTIVE)

  // true = offre commercialisable affichée sur les pages publiques ;
  // false = plan technique ou de test, réservé à l'administration.
  commercial Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules       PlanModule[]
  subscriptions SchoolSubscription[]
  changeRequests SubscriptionChangeRequest[]
  signupRequests SchoolSignupRequest[]
}

model PlanModule {
  id       String @id @default(cuid())
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  moduleId String
  module   PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([planId, moduleId])
}

/** Abonnement d'un établissement (historique conservé). */
model SchoolSubscription {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status             SubscriptionStatus @default(TRIALING)
  cycle              BillingCycle       @default(MONTHLY)
  startedAt          DateTime           @default(now())
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  graceEndsAt        DateTime?

  suspendedAt DateTime?
  cancelledAt DateTime?
  endedAt     DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events   SubscriptionEvent[]
  invoices PlatformInvoice[]

  @@index([schoolId, status])
  @@index([status, currentPeriodEnd])
}

model SubscriptionEvent {
  id             String @id @default(cuid())
  subscriptionId String
  subscription   SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type       SubscriptionEventType
  fromPlanId String?
  toPlanId   String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([subscriptionId, createdAt])
}

/** Activation/désactivation forcée d'un module pour une école (hors plan). */
model SchoolModuleOverride {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  moduleId String
  module   PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  enabled     Boolean
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([schoolId, moduleId])
}

/** Demande de changement d'offre émise par l'établissement (validation plateforme). */
model SubscriptionChangeRequest {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  subscriptionId  String?
  requestedPlanId String
  requestedPlan   SubscriptionPlan @relation(fields: [requestedPlanId], references: [id], onDelete: Restrict)

  note         String?
  status       ChangeRequestStatus @default(PENDING)
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([schoolId, status])
}

/**
 * Demande d'inscription publique d'un établissement (site vitrine).
 * Cycle : PENDING → CONTACTED → APPROVED → CONVERTED (ou REJECTED).
 * Aucun User/School n'est créé à la soumission — la conversion passe par
 * l'onboarding plateforme, qui rattache convertedSchoolId.
 */
model SchoolSignupRequest {
  id String @id @default(cuid())

  schoolName   String
  city         String?
  country      String?
  phone        String?
  email        String?
  website      String?

  contactName  String
  contactEmail String
  contactPhone String?

  note String?

  requestedPlanId String?
  requestedPlan   SubscriptionPlan? @relation(fields: [requestedPlanId], references: [id], onDelete: SetNull)

  status       SignupRequestStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?

  convertedSchoolId String?  @unique
  convertedSchool   School?  @relation(fields: [convertedSchoolId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([contactEmail])
}

// ---------- Facturation SaaS (indépendante des finances scolaires) ----------

/** Configuration facturation ECOM-TOUCH (singleton id="platform"). */
model PlatformConfig {
  id          String  @id @default("platform")
  legalName   String?
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String?
  taxId       String?
  invoiceFooter String?
  defaultGraceDays Int @default(7)
  updatedAt   DateTime @updatedAt
}

model PlatformInvoice {
  id             String @id @default(cuid())
  invoiceNumber  String @unique
  schoolId       String
  school         School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  subscriptionId String?
  subscription   SchoolSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  status  PlatformInvoiceStatus @default(ISSUED)
  cycle   BillingCycle          @default(MONTHLY)
  issueDate DateTime            @default(now())
  dueDate   DateTime
  periodStart DateTime?
  periodEnd   DateTime?

  total    Int
  currency String @default("XOF")
  snapshot Json? // émetteur, client, lignes, montants — immuable

  cancelledAt  DateTime?
  cancelReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines       PlatformInvoiceLine[]
  payments    PlatformPayment[]
  creditNotes PlatformCreditNote[]

  @@index([schoolId, status])
  @@index([status, dueDate])
}

model PlatformInvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  invoice   PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  label     String
  quantity  Int @default(1)
  unitPrice Int
  amount    Int
}

model PlatformPayment {
  id        String @id @default(cuid())
  invoiceId String
  invoice   PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  amount    Int
  paidAt    DateTime @default(now())
  method    String?
  reference String?
  observation String?
  receivedById String?

  status       PaymentStatus @default(VALIDATED)
  cancelledAt  DateTime?
  cancelledById String?
  cancelReason  String?

  idempotencyKey String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@index([schoolId])
}

/** Avoir (note de crédit) — réduit le solde dû de la facture. */
model PlatformCreditNote {
  id              String @id @default(cuid())
  creditNoteNumber String @unique
  invoiceId       String
  invoice         PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  amount      Int
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([schoolId])
}

/** Session d'assistance ECOM-TOUCH auprès d'un établissement (autorisée, limitée, journalisée). */
model SupportSession {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  agentId String
  agent   User   @relation(fields: [agentId], references: [id], onDelete: Restrict)

  reason         String
  authorizedById String?
  authorizedBy   User?   @relation("SupportAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)

  status    SupportSessionStatus @default(ACTIVE)
  startedAt DateTime             @default(now())
  expiresAt DateTime
  endedAt   DateTime?
  createdAt DateTime             @default(now())

  @@index([schoolId, status])
  @@index([agentId])
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SubscriptionEventType {
  CREATED
  TRIAL_STARTED
  TRIAL_EXTENDED
  ACTIVATED
  PLAN_CHANGED
  RENEWED
  PAST_DUE
  GRACE_STARTED
  SUSPENDED
  REACTIVATED
  CANCELLED
  EXPIRED
  CHANGE_REQUESTED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SignupRequestStatus {
  PENDING
  CONTACTED
  APPROVED
  CONVERTED
  REJECTED
}

enum PlatformInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SupportSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

// ===================== PHASE 9 — Communication multicanale =====================

enum MessageChannel {
  INTERNAL
  EMAIL
  SMS
  WHATSAPP
}

/** TRANSACTIONAL : communications nécessaires (non désinscriptibles). */
enum CommTopic {
  TRANSACTIONAL
  ACADEMIC
  FINANCE
  ANNOUNCEMENT
  OPTIONAL
}

enum MessageAudience {
  ALL_PARENTS
  CLASS_PARENTS
  GUARDIAN
  STUDENTS
  TEACHERS
  STAFF
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENT
  PARTIAL
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
  BLOCKED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  DEAD
}

enum PrefAction {
  OPT_IN
  OPT_OUT
}

/** Message émis par un établissement vers ses utilisateurs. */
model SchoolMessage {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  subject String
  body    String

  audience    MessageAudience
  classroomId String?
  guardianId  String?

  channels    MessageChannel[] @default([INTERNAL])
  topic       CommTopic        @default(OPTIONAL)
  status      MessageStatus    @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries MessageDelivery[]

  @@index([schoolId, status])
  @@index([schoolId, scheduledAt])
}

/** Une tentative d'envoi par destinataire et par canal. */
model MessageDelivery {
  id        String          @id @default(cuid())
  /** Nullable : les envois plateforme (reset, alertes SaaS) n'ont pas d'école. */
  schoolId  String?
  messageId String?
  message   SchoolMessage?  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId     String?
  guardianId String?
  channel    MessageChannel
  address    String?

  status      DeliveryStatus @default(QUEUED)
  attempts    Int            @default(0)
  lastError   String?
  providerRef String?
  costUnits   Int            @default(0)
  sentAt      DateTime?

  /** Déduplication : type métier + cible + période. */
  dedupKey String? @unique

  createdAt DateTime @default(now())

  @@index([schoolId, status])
  @@index([messageId])
  @@index([userId])
}

/** Préférence d'un utilisateur par canal et par sujet (OPTIONAL/ACADEMIC/etc.). */
model UserCommPreference {
  id      String         @id @default(cuid())
  userId  String
  channel MessageChannel
  topic   CommTopic
  enabled Boolean        @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, channel, topic])
  @@index([userId])
}

/** Historique des consentements (opt-in / opt-out). */
model CommConsentEvent {
  id     String         @id @default(cuid())
  userId String?
  channel MessageChannel
  topic   CommTopic
  action  PrefAction
  actorId String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Consentement des tuteurs sans compte (SMS/WhatsApp vers le téléphone). */
model GuardianCommConsent {
  id         String         @id @default(cuid())
  schoolId   String
  guardianId String         @unique
  smsOptIn   Boolean        @default(false)
  whatsappOptIn Boolean     @default(false)
  optOutAll  Boolean        @default(false)
  updatedAt  DateTime       @updatedAt
  createdAt  DateTime       @default(now())

  @@index([schoolId])
}

/** Templates de messages transactionnels, configurables par la plateforme. */
model MessageTemplate {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  channel  MessageChannel
  subject  String?
  body     String
  status   RecordStatus @default(ACTIVE)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/** File d'attente persistante : retries progressifs, déduplication, reprise. */
model Job {
  id      String @id @default(cuid())
  type    String
  payload Json
  schoolId String?

  runAt       DateTime @default(now())
  status      JobStatus @default(PENDING)
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  lastError   String?
  dedupKey    String?  @unique

  createdAt  DateTime @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, runAt])
  @@index([schoolId])
}

/** Historique d'exécution des tâches planifiées (automatisations). */
model TaskRun {
  id        String   @id @default(cuid())
  task      String
  scopeId   String?
  status    String
  detail    Json?
  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@index([task, startedAt])
}
