# ============================================================
# ECOM-SCHOOL — exemple de configuration d'environnement
# Copier vers `.env` et renseigner les valeurs réelles.
# Aucune valeur sensible ne doit être commitée.
# ============================================================

# --- Base de données ---
# PostgreSQL >= 15 requis.
DATABASE_URL="postgresql://user:password@host:5432/ecomschool?schema=public"

# --- Authentification (NextAuth) ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"
NEXTAUTH_SECRET="change-me"
# URL canonique de l'application (https en production).
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# --- Ordonnanceur externe (/api/cron) ---
# Secret partagé avec le planificateur (header Authorization: Bearer <secret>).
# Générer une valeur aléatoire longue. Sans cette variable, /api/cron → 503.
CRON_SECRET=""

# --- Fournisseurs de messages (optionnels) ---
# Si non configuré, le canal est marqué indisponible (jamais simulé).
# Email : passerelle HTTP transactionnelle.
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_TOKEN=""
# SMS : fournisseur compatible Burkina Faso (passerelle HTTP).
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
# Estimation de coût par segment SMS (XOF) pour les tableaux de bord.
SMS_COST_PER_SEGMENT=""
# WhatsApp Business Platform (API officielle Meta).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Nom du template Meta approuvé pour l'alerte « nouvelle demande ».
WHATSAPP_TEMPLATE_SIGNUP=""
# Mode test : 1 = aucune requête sortante vers Meta (livraisons tracées DRYRUN).
WHATSAPP_DRY_RUN=""

# --- Abonnements (lot A2) ---
# 1 = bascule vers la matrice V2 (clés corrigées, FINANCE_CORE/FINANCE_MGMT).
# N'activer qu'en coordination avec la mise à jour de PlanModule — voir
# docs/a2-preparation-technique-abonnements.md. Inactif par défaut.
SUBSCRIPTION_MATRIX_V2=""

# --- Automatisations ---
# Délai de grâce (minutes) avant notification d'absence non justifiée.
ABSENCE_NOTIFY_DELAY_MIN="30"

# --- Rétention des données (jours ; 0 = jamais purgé) ---
RETENTION_JOB_DAYS="90"
RETENTION_DELIVERY_DAYS="365"
RETENTION_INVITE_DAYS="30"
RETENTION_AUDIT_DAYS="0"
RETENTION_NOTIFICATION_DAYS="0"

# --- App ---
NEXT_PUBLIC_APP_NAME="ECOM-SCHOOL"

# --- Dev / scripts de test ---
SEED_TEST_PASSWORD=""
SEED_DEMO_PASSWORD=""
# Surcharge du binaire PostgreSQL pour le test de restauration.
# PG_BIN="C:\\Program Files\\PostgreSQL\\18\\bin"

# --- Documents privés (G2-A) ---
# Racine de stockage hors racine web — jamais servie par Nginx.
# DOCUMENTS_ROOT="./documents-private"        # défaut local
# DOCUMENTS_MAX_BYTES="5242880"               # 5 Mo/fichier
# DOCUMENTS_DEFAULT_QUOTA_BYTES="524288000"   # 500 Mo/école
# DOCUMENTS_PURGE_AFTER_DAYS="30"             # purge physique des DELETED
