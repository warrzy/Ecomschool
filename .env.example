# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecomschool_dev?schema=public"

# Auth
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# App
NEXT_PUBLIC_APP_NAME="ECOM-SCHOOL"

# Dev seed / scripts
SEED_TEST_PASSWORD="change-me"
