# ============================================================
# ECOM-SCHOOL — Préproduction (VPS Hostinger)
# Copier vers /var/www/ecomschool-preprod/shared/.env et renseigner.
# (lien symbolique .env créé dans chaque release par deploy.sh)
# AUCUN secret réel dans ce fichier.
# ============================================================

# --- Environnement ---
NODE_ENV="production"

# --- Base de données (rôle applicatif dédié, privilèges minimaux) ---
DATABASE_URL="postgresql://ecomschool_app:CHANGE_ME@127.0.0.1:5432/ecomschool_preprod?schema=public"

# --- Authentification ---
# Générer : openssl rand -hex 32  (deux valeurs distinctes ou identiques)
AUTH_SECRET="CHANGE_ME"
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="https://preprod.ecomschool.fr"
AUTH_URL="https://preprod.ecomschool.fr"

# --- Ordonnanceur (/api/cron) ---
# openssl rand -hex 32 — le même secret côté crontab système.
CRON_SECRET="CHANGE_ME"

# --- Mobile Money : verrou global des paiements RÉELS ---
# Kill-switch serveur indépendant de l'activation par école
# (PaymentProvider.liveEnabled). Toute opération susceptible de
# contacter un prestataire réel (initiation, statut, remboursement)
# exige "true" explicitement ici. Toute autre valeur = verrouillé.
# PRÉPRODUCTION : laisser false tant qu'aucun contrat opérateur
# n'est signé et documenté (docs/g3e-provider-integration-checklist.md).
MOBILE_MONEY_LIVE_ENABLED="false"
# Phase 3B — commutateur DISTINCT des appels distants TEST (sandbox-api
# officielle, secrets TEST dédiés). Distinct du verrou LIVE : activer
# l'un n'active jamais l'autre. Aucun paiement opérationnel issu du
# TEST n'est comptabilisé — laisser false hors recette encadrée.
MOBILE_MONEY_REMOTE_TEST_ENABLED="false"

# --- Fournisseurs de messages (laisser vide = canal indisponible) ---
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_TOKEN=""
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
SMS_COST_PER_SEGMENT=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_SIGNUP=""
# 1 = aucun appel réseau vers Meta (préproduction : garder à 1).
WHATSAPP_DRY_RUN="1"

# --- Abonnements (lot A2) ---
# 1 = matrice V2 active. À n'activer qu'après la mise à jour coordonnée de
# PlanModule (FINANCE_CORE/FINANCE_MGMT) — voir
# docs/a2-preparation-technique-abonnements.md. Laisser vide tant que non validé.
SUBSCRIPTION_MATRIX_V2=""

# --- Automatisations ---
ABSENCE_NOTIFY_DELAY_MIN="30"

# --- Rétention (jours ; 0 = jamais purgé) ---
RETENTION_JOB_DAYS="90"
RETENTION_DELIVERY_DAYS="365"
RETENTION_INVITE_DAYS="30"
RETENTION_AUDIT_DAYS="0"
RETENTION_NOTIFICATION_DAYS="0"

# --- App ---
NEXT_PUBLIC_APP_NAME="ECOM-SCHOOL"

# --- Sauvegarde distante (P7a) — une des deux options ---
# Option restic (recommandée : chiffré côté client, déduplication, snapshots) :
#   restic installé sur le VPS (binaire statique), cible S3/B2/SFTP.
# RESTIC_REPOSITORY="s3:https://s3.<region>.<provider>/<bucket>/ecomschool"
# RESTIC_PASSWORD="CHANGE_ME"          # clé de chiffrement du dépôt
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (ou équivalent restic) si S3
# Option rsync/SSH (compte distant restreint, transport chiffré) :
# BACKUP_REMOTE="backupuser@<hote>:/backups/ecomschool"
# BACKUP_REMOTE_SSH="backupuser@<hote>"  # optionnel : vérifie l'empreinte distante
# Rétention locale (jours) :
RETENTION_DAYS="14"
# Rétention distante restic (générations) :
# RESTIC_KEEP_DAILY="14" RESTIC_KEEP_WEEKLY="8" RESTIC_KEEP_MONTHLY="12"
# Sauvegardes volontairement locales uniquement (désactive l'alerte
# "aucune copie distante" dans monitor.sh) :
BACKUP_LOCAL_ONLY="1"

# --- Supervision / alertes (monitor.sh, toutes les 15 min) ---
# ALERT_WEBHOOK_URL="https://<webhook>"     # POST JSON {key,title,body,host,at}
# ALERT_EMAIL_TO="ops@…"                   # via EMAIL_PROVIDER_URL si pas de webhook
# BACKUP_MAX_AGE_HOURS="26"                # alerte si dernier dump plus vieux
# DISK_ALERT_PCT="90"                      # alerte disque
# ALERT_DEDUP_HOURS="24"                   # anti-spam par condition

# --- Bootstrap préproduction (premier déploiement uniquement) ---
# Compte propriétaire plateforme créé par scripts/preprod/create-platform-admin.ts
PREPROD_PLATFORM_ADMIN_EMAIL="admin@ecom-touch.example"
PREPROD_PLATFORM_ADMIN_PASSWORD="CHANGE_ME"

# --- Documents privés (G2-A) — stockage partagé entre releases ---
# Hors racine web : servi uniquement via /app/documents/[id]/download.
DOCUMENTS_ROOT="/var/www/ecomschool-preprod/shared/uploads"
# DOCUMENTS_MAX_BYTES="5242880"
# DOCUMENTS_DEFAULT_QUOTA_BYTES="524288000"
# DOCUMENTS_PURGE_AFTER_DAYS="30"
