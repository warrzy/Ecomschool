# ============================================================
# ECOM-SCHOOL — Préproduction (VPS Hostinger)
# Copier vers /var/www/ecomschool-preprod/.env et renseigner.
# AUCUN secret réel dans ce fichier.
# ============================================================

# --- Environnement ---
NODE_ENV="production"

# --- Base de données (rôle applicatif dédié, privilèges minimaux) ---
DATABASE_URL="postgresql://ecomschool_app:CHANGE_ME@127.0.0.1:5432/ecomschool_preprod?schema=public"

# --- Authentification ---
# Générer : openssl rand -hex 32  (deux valeurs distinctes ou identiques)
AUTH_SECRET="CHANGE_ME"
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="https://preprod.ecomschool.fr"
AUTH_URL="https://preprod.ecomschool.fr"

# --- Ordonnanceur (/api/cron) ---
# openssl rand -hex 32 — le même secret côté crontab système.
CRON_SECRET="CHANGE_ME"

# --- Fournisseurs de messages (laisser vide = canal indisponible) ---
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_TOKEN=""
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
SMS_COST_PER_SEGMENT=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Automatisations ---
ABSENCE_NOTIFY_DELAY_MIN="30"

# --- Rétention (jours ; 0 = jamais purgé) ---
RETENTION_JOB_DAYS="90"
RETENTION_DELIVERY_DAYS="365"
RETENTION_INVITE_DAYS="30"
RETENTION_AUDIT_DAYS="0"
RETENTION_NOTIFICATION_DAYS="0"

# --- App ---
NEXT_PUBLIC_APP_NAME="ECOM-SCHOOL"

# --- Bootstrap préproduction (premier déploiement uniquement) ---
# Compte propriétaire plateforme créé par scripts/preprod/create-platform-admin.ts
PREPROD_PLATFORM_ADMIN_EMAIL="admin@ecom-touch.example"
PREPROD_PLATFORM_ADMIN_PASSWORD="CHANGE_ME"
